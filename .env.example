# Public base URL of the customer menu app. Catalog links and QR codes are built from it:
#   <NEXT_PUBLIC_APP_URL>/r/<restaurant-slug>
# Set it once the production domain is final. If unset, the app uses NEXT_PUBLIC_SITE_URL,
# then Vercel's production domain (VERCEL_PROJECT_PRODUCTION_URL), then http://localhost:3000.
# NEXT_PUBLIC_APP_URL=https://example.com

# Public base URL of the marketing site. Used for canonical + Open Graph URLs.
# Leave unset locally; on Vercel it falls back to the deployment URL automatically.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Root domain restaurant menus may eventually live under (e.g. <restaurant>.<root>).
# Not used yet; menus live at /r/<restaurant-slug> for now.
# NEXT_PUBLIC_ROOT_DOMAIN=example.com

# --- Supabase (database + admin sign-in) ------------------------------------------------------
# Dashboard -> Project Settings -> API Keys. Both values are designed to be public: Row Level
# Security decides what each visitor can read. Never put the secret / service_role key here;
# the app doesn't use it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Cloudflare R2 (3D models and images) -- SERVER ONLY, never prefix with NEXT_PUBLIC_ ---------
# R2 -> Manage API tokens -> Account API token with "Object Read & Write" on the two buckets below
# only. The secret is shown once when the token is created.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Uploads and drafts (never public) and published copies (served to customers).
R2_PRIVATE_BUCKET=dekhkhao-assets
R2_PUBLIC_BUCKET=dekhkhao-public

# Public base URL of the published-assets bucket (custom domain, or the r2.dev URL in development).
# Not set until public delivery is approved; published menus can't load models without it.
# NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.example.com

# Supabase CLI only (db push / link). Keep it in .env.supabase.local, which Next.js doesn't load.
# SUPABASE_DB_PASSWORD=

# Dev-time tools only (never needed on Vercel):
# USD_PYTHON=C:/path/to/python-with-usd-core/python.exe   # for npm run catalog:assets (USDZ -> GLB)
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe   # for poster/thumbnail renders
