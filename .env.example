# Public base URL of the customer menu app. Catalog links and QR codes are built from it:
#   <NEXT_PUBLIC_APP_URL>/r/<restaurant-slug>
# Set it once the production domain is final. If unset, the app uses NEXT_PUBLIC_SITE_URL,
# then Vercel's production domain (VERCEL_PROJECT_PRODUCTION_URL), then http://localhost:3000.
# NEXT_PUBLIC_APP_URL=https://example.com

# Public base URL of the marketing site. Used for canonical + Open Graph URLs.
# Leave unset locally; on Vercel it falls back to the deployment URL automatically.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Root domain restaurant menus may eventually live under (e.g. <restaurant>.<root>).
# Not used yet; menus live at /r/<restaurant-slug> for now.
# NEXT_PUBLIC_ROOT_DOMAIN=example.com

# Dev-time tools only (never needed on Vercel):
# USD_PYTHON=C:/path/to/python-with-usd-core/python.exe   # for npm run catalog:assets (USDZ -> GLB)
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe   # for poster/thumbnail renders
